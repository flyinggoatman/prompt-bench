# Copy to .env and fill in. The .env file must never be committed to any repo.
BENCH_USER=admin
BENCH_PASS=pass

# Unlock codes are managed on the admin page (Unlock codes card) and kept in
# uploads/unlock-codes.db. Codes set here still work and show there read only.
# Optional unlock codes: CODE:group pairs, comma separated. A private pack that
# says "unlock": "group" becomes visible to a browser that has typed the code,
# for BENCH_UNLOCK_DAYS days (default 180), without signing in. Letters and
# digits only, case does not matter. One code can open several groups joined
# with +, e.g. PAIRCODE:alice+bob. A group of * opens every private pack.
# Keep real codes in .env only; this file is published.
# BENCH_UNLOCK_CODES=
# BENCH_UNLOCK_DAYS=180
# Signs unlock cookies. Without it the key comes from the admin password, so a
# password change locks every browser. Fill with: openssl rand -hex 32
# BENCH_SECRET=
# Each redemption gets an id (see GET /api/unlock/redemptions, signed in, or
# `docker logs`). Ids listed here stop working at once, comma separated.
# Revoking from the admin page (Redemptions card) works too, with no restart.
# BENCH_UNLOCK_REVOKED=
# Behind Traefik or another proxy you control, so rate limits see real visitors:
# BENCH_TRUST_PROXY=1
# What / serves: studio (default), classic, or home for the landing page.
# BENCH_HOME=studio

# Membership: a one-off payment opens the MCP tools and the agent API; the
# website stays free. Off unless set. See docs/membership.md.
# BENCH_MEMBERSHIP=1
# BENCH_MEMBERSHIP_CHECKOUT_URL=https://buy.stripe.com/...
# BENCH_MEMBERSHIP_PRICE=
# STRIPE_WEBHOOK_SECRET=
# BENCH_STRIPE_PAYMENT_LINKS=
